{
  "manifest_version": 3,
  "name": "IDM Fast Downloader - دانلود با IDM",
  "version": "1.8.8",
  "description": "رهگیری خودکار و هوشمند لینک‌های دانلود و باز کردن مستقیم پنجره دیالوگ دانلود IDM در تمام مرورگرها",
  "key": "",
  "browser_specific_settings": {
    "gecko": {
      "id": "idm-fast-downloader@mahdi-hp.ir",
      "strict_min_version": "109.0"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "IDM Fast Downloader",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "permissions": [
    "nativeMessaging",
    "downloads",
    "contextMenus",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
